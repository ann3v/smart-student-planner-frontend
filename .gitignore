# ============================================================
# Smart Student Planner — Root .gitignore (Monorepo)
# ============================================================
# Covers both /frontend (Expo/React Native) and /backend (Node/Express)
# Frontend-specific and backend-specific rules are kept in their
# respective subdirectory .gitignore files where unavoidable.

# ============================================================
# DEPENDENCIES
# ============================================================
node_modules/

# ============================================================
# ENVIRONMENT & SECRETS
# ============================================================
# NEVER commit .env files — rotate secrets immediately if found
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging

# Explicitly ALLOW .env.example (template with placeholder values)
!.env.example

# ============================================================
# LOGS
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# BUILD OUTPUTS
# ============================================================
dist/
build/
.next/
out/
.expo/
web-build/

# ============================================================
# DATABASES & LOCAL STORAGE
# ============================================================
*.sqlite
*.sqlite3
*.db
*.db-journal

# ============================================================
# COVERAGE & TESTING
# ============================================================
coverage/
.nyc_output/
*.lcov

# ============================================================
# OPERATING SYSTEM
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================================
# EDITORS & IDEs
# ============================================================
# VSCode workspace settings can be committed if intentional;
# user-level preferences should never be committed
.vscode/settings.json
.vscode/extensions.json
.vscode/launch.json
.vscode/tasks.json

# JetBrains / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Other editors
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
.project
.classpath
.settings/

# ============================================================
# UPLOADS & USER-GENERATED FILES
# ============================================================
uploads/
tmp/
temp/

# ============================================================
# CERTIFICATES & SIGNING KEYS
# ============================================================
*.pem
*.p12
*.pfx
*.jks
*.p8
*.key
*.mobileprovision

# ============================================================
# EXPO (React Native)
# ============================================================
# Native build folders generated by `expo prebuild` or `expo eject`
/ios/
/android/

# Metro bundler
.metro-health-check*

# TypeScript incremental builds
*.tsbuildinfo

# Expo generated type declaration (auto-generated)
expo-env.d.ts

# Kotlin (Android native)
.kotlin/

# React Native patch artifacts
*.orig.*

# ============================================================
# NODE / EXPRESS
# ============================================================
# Nothing additional beyond what's already covered above.
# The backend has no build step, so no /dist or /build needed there.

# ============================================================
# MISC
# ============================================================
*.tgz
*.tar.gz
*.zip
.cache/