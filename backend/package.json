{
  "name": "smart-student-planner-backend",
  "version": "1.0.0",
  "description": "Backend API for Smart Student Planner",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "dev": "nodemon --exec ts-node server.ts",
    "setup-db": "ts-node setup-database.ts",
    "migrate": "ts-node migrate.ts",
    "build": "tsc",
